# Keep this file private: chmod 0600 ~/.config/oixc-proxy/oixc-proxy.conf
token=REPLACE_WITH_OIXC_ACCESS_TOKEN
listen=127.0.0.1:6172
nodelist-listen=127.0.0.1:6173
node-refresh-interval=1h

# Optional performance tuning. Detailed tracing is disabled by default;
# 1000 records roughly one request in every 1000.
# request-timeout=15s
# udp-idle-timeout=5m
# Remote SOCKS5 UDP requires both a fixed relay range and the address clients
# can reach. Publish the same UDP range through NAT and the host firewall.
# udp-port-range=10000-10099
# udp-advertise-address=192.168.1.10
# max-client-connections=256
# dial-concurrency=32
# per-node-dial-concurrency=8
# reuse-max-idle=8
# reuse-max-uses=32
# reuse-idle-timeout=90s
# perf-trace-sample-every=1000

# For a trusted LAN host, use wildcard listeners and publish one specific IP:
# listen=0.0.0.0:6172
# nodelist-listen=0.0.0.0:6173
# outbound-ip=10.0.0.16
# udp-port-range=10000-10099
# udp-advertise-address=10.0.0.16
